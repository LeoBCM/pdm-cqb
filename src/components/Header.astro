---
import Logo from '../../public/favicon.svg'
import Nav from './Nav.astro';
import ThemeIcon from './ThemeIcon.astro'
---
<style>
  header {
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 999;
  }
  div {
    display: flex;
    max-height: 16%;
    background-color: #3c103c;
    color: #e6e1e9;
  }
  html.dark div {
    background-color: #5c305c;
    color: #ffd8e6
  }
  label {
    margin-top: auto;
    margin-bottom: auto;
    margin-left: 1%;
    margin-right: 1%;
    max-width: 2.8%;
  }
  input {
    display: none;
  }
</style>
<header>
  <nav>
    <div>
      <label for="checkbox">
        <Logo />
      </label>
      <Nav />
      <ThemeIcon />
    </div>
  </nav>
</header>
